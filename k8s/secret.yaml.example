# Copiar a secret.yaml (que está en .gitignore), reemplazar los valores y aplicar:
#   kubectl apply -f k8s/secret.yaml
# O bien crear el Secret sin archivo:
#   kubectl create secret generic crea3-secret \
#     --from-literal=DB_USER=... --from-literal=DB_PASS=... --from-literal=MYSQL_ROOT_PASSWORD=...
apiVersion: v1
kind: Secret
metadata:
  name: crea3-secret
type: Opaque
stringData:
  DB_USER: "CAMBIAR"
  DB_PASS: "CAMBIAR"
  MYSQL_ROOT_PASSWORD: "CAMBIAR"
