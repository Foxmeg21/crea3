# Copiar este archivo a .env y completar los valores. NO subir .env al repositorio.

# --- Conexión usada por la aplicación ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
# PREFERRED (local) o REQUIRED (Aiven)
DB_SSL_MODE=

# --- Base de datos del contenedor (solo docker compose) ---
MYSQL_ROOT_PASSWORD=

# Usuario de GitHub en minúsculas (para el nombre de la imagen en ghcr.io)
GITHUB_USER=
